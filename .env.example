# ============ 服务 ============
# development 用于本机试跑；生产请设置为 production
APP_ENV=development
# 监听地址
ADDR=:8080
# 保存设置后是否自动重启服务（true / false）
AUTO_RESTART=true

# ============ 数据库（三选一：postgres / mysql / sqlite） ============
# SQLite 仅用于本地试跑，生产请用 PostgreSQL 或 MySQL
DB_DRIVER=sqlite
DB_DSN=data/r2admin.db

# PostgreSQL 示例：
# DB_DRIVER=postgres
# DB_DSN=postgres://user:password@db.example.com:5432/r2admin?sslmode=verify-full

# MySQL 示例：
# DB_DRIVER=mysql
# DB_DSN=user:password@tcp(127.0.0.1:3306)/r2admin?charset=utf8mb4&parseTime=True&loc=Local

# ============ 存储（r2 / local） ============
# local 仅用于开发试跑，生产请用 r2
STORAGE_DRIVER=local
LOCAL_DATA_DIR=data/files

# Cloudflare R2 配置（STORAGE_DRIVER=r2 时必填）
# Account ID 在 Cloudflare 控制台右侧栏可见
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket 名称
R2_BUCKET=site-images
# 绑定到 R2 的图片域名，例如 https://img.example.com
PUBLIC_BASE_URL=

# ============ 管理员与安全 ============
# 首次启动时创建该账号，之后可在“系统设置 → 安全”修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# 生成方式：openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_TTL_HOURS=12

# 为空时仅允许同源管理后台请求；多个精确来源以英文逗号分隔。
CORS_ALLOWED_ORIGINS=
# 审计日志保留天数（30-3650）
AUDIT_RETENTION_DAYS=180

# ============ 图片处理 ============
# 生成尺寸（宽度 px），按需修改
IMG_SIZES=400,800,1200,1600
# 输出格式：webp 必留，可加 avif（需 libvips 带 heif 支持）
IMG_FORMATS=webp
IMG_QUALITY=82
IMG_KEEP_ORIGINAL=true
UPLOAD_MAX_MB=20

# ============ AI 生图（OpenAI Images API） ============
# 默认使用 OpenAI 官方地址，兼容任何 OpenAI Images API 兼容网关
AI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
# 可选：限制 AI 生图网关主机名，多个以英文逗号分隔
AI_IMAGE_ALLOWED_HOSTS=api.openai.com
